%%{init: {"htmlLabels": true, "flowchart": {"curve": "linear", "nodeSpacing": 16, "rankSpacing": 20}, "themeVariables": {"fontFamily": "Arial, Helvetica, sans-serif", "fontSize": "21px"}}}%%
flowchart LR
    F["Metadata feeds<br/>Zotero groups | GitHub adapters<br/>PID and institutional sources"]

    G["Lab-in-a-Box toolkit<br/>persistent Dump Things + SHACL-vue<br/>Forgejo for identity | collaboration | CI"]

    subgraph O["Orinoco: open, lab-owned research-information system"]
        direction LR
        M["DataLad Concepts<br/>LinkML research model"]
        E["Feed + enrichment<br/>workflows"]
        V["SHACL-vue<br/>model-driven entry and review"]
        P["Dump Things metadata pool<br/>incoming → curation → official records<br/><b>operational source of truth</b>"]
        Q["Open retrieval + projection<br/>REST API | dtc | qri"]

        M -. "forms and validation" .-> V
        M -. "schema validation" .-> P
        E <--> P
        V <--> P
        P --> Q
    end

    G -. "service-backed deployment" .-> O

    F -->|"candidate records via CI adapters"| O
    O --> U["Lab uses<br/><b>website</b> (Hugo + graph)<br/>reports | catalogs | discovery<br/>AI-assisted work"]

    O -. "shared IDs + ontology mappings" .-> K["Other governed<br/>research graphs"]

    L["Additional deployment option: Orinoco Lite<br/>modeled YAML + Git pull-request review<br/>GitHub Action: validate + project + publish"]
    O -. "same model" .-> L

