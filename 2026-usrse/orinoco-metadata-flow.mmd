    classDef tool fill:#eef7ee,stroke:#39734a,color:#173b22,stroke-width:1.5px;
    classDef pool fill:#dcefe2,stroke:#1f6b3a,color:#12351f,stroke-width:2.5px;
    classDef use fill:#fff6dc,stroke:#9a7422,color:#4a3710,stroke-width:1.5px;
    classDef note fill:#f4f4f4,stroke:#777,color:#333,stroke-width:1.25px,stroke-dasharray:4 3;

    class F feed;
    class M model;
    class E,V,Q,G tool;
