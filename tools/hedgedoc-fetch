#!/usr/bin/env python3
"""Fetch a HedgeDoc markdown slide deck, and the images it uses, for local
(offline) rendering with hedgedoc.html of this repository.

Usage: tools/hedgedoc-fetch URL [DESTDIR]

URL is the raw markdown: e.g. https://example.com/talk.md, or for a
HedgeDoc note https://<hedgedoc-server>/<note-id>/download .
DESTDIR defaults to _hedgedoc/<name>/ (git-ignored) at the repository root.
Images are saved under DESTDIR/uploads/ and referenced relative to the
markdown, which is saved as DESTDIR/<name>.md .  Re-running refreshes the
markdown and fetches only images not downloaded yet.
"""

import os
import re
import sys
import urllib.parse
import urllib.request
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
IMAGE_URL_RE = re.compile(
    r"""https?://[^\s<>"'()]+?\.(?:png|jpe?g|gif|svg|webp|avif)(?=[\s<>"')?#]|$)""",
    re.IGNORECASE,
)


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "hedgedoc-fetch"})
    with urllib.request.urlopen(req) as response:
        return response.read()


def main(url, destdir=None):
    path = urllib.parse.urlparse(url).path.rstrip("/")
    if path.endswith("/download"):
        path = path[: -len("/download")]
    name = Path(path).stem or "talk"
    dest = Path(destdir) if destdir else REPO_ROOT / "_hedgedoc" / name

    try:
        text = fetch(url).decode("utf-8")
    except Exception as exc:
        sys.exit(f"Failed to fetch {url}: {exc}")
    if re.match(r"\s*<(!doctype|html)", text, re.IGNORECASE):
        sys.exit(
            f"{url} returned HTML, not markdown. For a HedgeDoc note use "
            "<note-url>/download (and the note must be readable without login)."
        )

    uploads = dest / "uploads"
    uploads.mkdir(parents=True, exist_ok=True)
    for image_url in sorted(set(IMAGE_URL_RE.findall(text))):
        local = uploads / Path(urllib.parse.urlparse(image_url).path).name
        if not local.exists():
            try:
                local.write_bytes(fetch(image_url))
            except Exception as exc:
                print(f"WARNING: kept remote {image_url}: {exc}", file=sys.stderr)
                continue
            print(f"got {image_url}")
        text = text.replace(image_url, f"uploads/{local.name}")

    md = dest / f"{name}.md"
    md.write_text(text, encoding="utf-8")
    print(f"saved {md}")

    try:
        rel = md.resolve().relative_to(REPO_ROOT)
    except ValueError:
        print(
            f"NB: {dest} is outside of {REPO_ROOT}, the web server has to "
            "serve it too.",
            file=sys.stderr,
        )
        rel = md.resolve()
    query = urllib.parse.quote(str(rel), safe="/")
    cd = "" if Path.cwd() == REPO_ROOT else f"cd {os.path.relpath(REPO_ROOT)} && "
    print(
        f"\nTo view:\n  {cd}python3 -m http.server 8000   # or: npm start\n"
        f"  http://localhost:8000/hedgedoc.html?md={query}"
    )


if __name__ == "__main__":
    if not 2 <= len(sys.argv) <= 3 or sys.argv[1] in ("-h", "--help"):
        sys.exit(__doc__)
    main(*sys.argv[1:])
